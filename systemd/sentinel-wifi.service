[Unit]
Description=Sentinel WiFi Capture Daemon
After=network.target
Wants=sentinel-ingest.service

[Service]
Type=simple
ExecStart=/home/user/sentinel/.venv/bin/python -m sentinel.capture.wifi --config /home/user/sentinel/config.yaml
WorkingDirectory=/home/user/sentinel
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-wifi

# Security hardening
NoNewPrivileges=no
ProtectSystem=strict
ReadWritePaths=/home/user/sentinel/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
